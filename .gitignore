# Raw data is reproducible: generate_retail_pulse.py is seeded with SEED = 20240101,
# so these two CSVs (104 MB together) never need to be committed. Small aggregates
# written by src/precompute.py into data/processed/ ARE committed -- the dashboard
# reads them, and they are only a few MB.
data/raw/
*.csv
!data/processed/*.csv
!reports/drift/*.csv

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
env/
*.egg-info/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Secrets -- never commit these
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service_account*.json

# Streamlit
.streamlit/secrets.toml

# Model artefacts that are large and regenerable.
# Small, deliberately-committed artefacts (metrics json, small aggregates) stay.
models/*.pkl
models/*.joblib
models/*.h5
models/*.keras
models/*/scaler.pkl
models/*/encoder.pkl

# Data-quality reports that are large logs rather than deliverables.
*.log

# Drift evidence stays committed, including the Evidently bundle.
#
# This was previously ignored as "~4 MB and regenerable". Both halves of that are wrong here.
# `data/raw/` is ignored, so a fresh clone cannot re-run `python -m src.drift` at all without
# first regenerating the 104 MB raw panel -- so the artefact is not actually regenerable by the
# person reviewing it. And these are deliverables, not logs: reports/RetailPulse_Report.md
# quotes drift_summary.csv, tests/test_figures.py reads it, and reports/demo_video_outline.md
# tells the evaluator to open evidently_drift.html on screen.
reports/drift/_probe.html